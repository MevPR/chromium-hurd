# Toolchains for Debian GNU/Hurd. The Hurd is treated as a variant of Linux
# (is_linux is true, see //build/config/BUILDCONFIG.gn) that is selected by
# current_os == "hurd" and compiled with the x86_64-unknown-hurd-gnu triple.

import("//build/toolchain/gcc_toolchain.gni")

clang_toolchain("clang_x64") {
  toolchain_args = {
    current_cpu = "x64"
    current_os = "hurd"
  }
}
