+#include "build/build_config.h"
+
+#if BUILDFLAG(IS_HURD)
+// GNU/Hurd has no DMA-BUF, so these descriptors never exist. The Hurd's _IO*
+// macros need a type description for every struct, so the request numbers
+// are spelled out with the Linux encoding.
+#include <stdint.h>
+
+struct dma_buf_sync {
+  uint64_t flags;
+};
+
+struct dma_buf_export_sync_file {
+  uint32_t flags;
+  int32_t fd;
+};
+
+struct dma_buf_import_sync_file {
+  uint32_t flags;
+  int32_t fd;
+};
+
+constexpr uint64_t DMA_BUF_SYNC_READ = 1 << 0;
+constexpr uint64_t DMA_BUF_SYNC_WRITE = 2 << 0;
+constexpr uint64_t DMA_BUF_SYNC_RW = DMA_BUF_SYNC_READ | DMA_BUF_SYNC_WRITE;
+constexpr uint64_t DMA_BUF_SYNC_START = 0 << 2;
+constexpr uint64_t DMA_BUF_SYNC_END = 1 << 2;
+
+constexpr unsigned long HurdLinuxIoc(unsigned long dir,
+                                     unsigned long nr,
+                                     unsigned long size) {
+  return (dir << 30) | (size << 16) | ('b' << 8) | nr;
+}
+constexpr unsigned long DMA_BUF_IOCTL_SYNC =
+    HurdLinuxIoc(1, 0, sizeof(dma_buf_sync));
+constexpr unsigned long DMA_BUF_IOCTL_EXPORT_SYNC_FILE =
+    HurdLinuxIoc(3, 2, sizeof(dma_buf_export_sync_file));
+constexpr unsigned long DMA_BUF_IOCTL_IMPORT_SYNC_FILE =
+    HurdLinuxIoc(1, 3, sizeof(dma_buf_import_sync_file));
+
+#else  // BUILDFLAG(IS_HURD)
+
 #include <linux/version.h>
 
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(4, 11, 0)
@@ -45,4 +87,6 @@ constexpr unsigned long DMA_BUF_IOCTL_IMPORT_SYNC_FILE =
     _IOW(DMA_BUF_BASE, 3, struct dma_buf_import_sync_file);
 #endif
 
+#endif  // BUILDFLAG(IS_HURD)
+
 #endif  // UI_GFX_LINUX_DMABUF_UAPI_H_
