diff --git a/v8/BUILD.gn b/v8/BUILD.gn
index 8956a3dc35..b131ec8588 100644
--- a/v8/BUILD.gn
+++ b/v8/BUILD.gn
@@ -1215,7 +1215,9 @@ if (target_os == "android") {
 } else if (target_os == "ios") {
   enabled_external_v8_defines += [ "V8_HAVE_TARGET_OS" ]
   enabled_external_v8_defines += [ "V8_TARGET_OS_IOS" ]
-} else if (target_os == "linux") {
+} else if (target_os == "linux" || target_os == "hurd") {
+  # GNU/Hurd uses the Linux ABI as far as V8 is concerned (ELF, SysV x86-64,
+  # glibc); kernel-specific features are excluded via __GNU__ in v8config.h.
   enabled_external_v8_defines += [ "V8_HAVE_TARGET_OS" ]
   enabled_external_v8_defines += [ "V8_TARGET_OS_LINUX" ]
 } else if (target_os == "mac") {
diff --git a/v8/include/v8config.h b/v8/include/v8config.h
index b7aeeade6b..19ea5dd0c2 100644
--- a/v8/include/v8config.h
+++ b/v8/include/v8config.h
@@ -81,6 +81,7 @@ path. Add it with -I<path> to the command line
 //  V8_OS_DRAGONFLYBSD  - DragonFlyBSD
 //  V8_OS_FREEBSD       - FreeBSD
 //  V8_OS_FUCHSIA       - Fuchsia
+//  V8_OS_HURD          - GNU/Hurd
 //  V8_OS_LINUX         - Linux (Android, ChromeOS, Linux, ...)
 //  V8_OS_DARWIN        - Darwin (macOS, iOS)
 //  V8_OS_MACOS         - macOS
@@ -127,6 +128,12 @@ path. Add it with -I<path> to the command line
 # define V8_OS_POSIX 1
 # define V8_OS_STRING "linux"
 
+#elif defined(__GNU__)
+// GNU/Hurd: POSIX with a glibc/ELF userland, but not the Linux kernel.
+# define V8_OS_HURD 1
+# define V8_OS_POSIX 1
+# define V8_OS_STRING "hurd"
+
 #elif defined(__sun)
 # define V8_OS_POSIX 1
 # define V8_OS_SOLARIS 1
diff --git a/v8/src/base/platform/platform-posix.cc b/v8/src/base/platform/platform-posix.cc
index 7add12aa47..a0cbcb630f 100644
--- a/v8/src/base/platform/platform-posix.cc
+++ b/v8/src/base/platform/platform-posix.cc
@@ -919,6 +919,9 @@ int OS::GetCurrentProcessId() {
 int OS::GetCurrentThreadIdInternal() {
 #if V8_OS_DARWIN || (V8_OS_ANDROID && defined(__APPLE__))
   return static_cast<int>(pthread_mach_thread_np(pthread_self()));
+#elif V8_OS_HURD
+  // No kernel thread ids on GNU/Hurd; pthread_t is a small integer handle.
+  return static_cast<int>(pthread_self());
 #elif V8_OS_LINUX
   return static_cast<int>(syscall(__NR_gettid));
 #elif V8_OS_ANDROID
@@ -1229,7 +1232,12 @@ Thread::Thread(const Options& options)
       stack_size_(options.stack_size()),
       priority_(options.priority()),
       start_semaphore_(nullptr) {
+#if defined(PTHREAD_STACK_MIN)
   const int min_stack_size = static_cast<int>(PTHREAD_STACK_MIN);
+#else
+  // GNU/Hurd does not define PTHREAD_STACK_MIN.
+  const int min_stack_size = static_cast<int>(sysconf(_SC_THREAD_STACK_MIN));
+#endif
   if (stack_size_ > 0) stack_size_ = std::max(stack_size_, min_stack_size);
   set_name(options.name());
 }
@@ -1245,6 +1253,8 @@ static void SetThreadName(const char* name) {
 #elif V8_OS_NETBSD
   static_assert(Thread::kMaxThreadNameLength <= PTHREAD_MAX_NAMELEN_NP);
   pthread_setname_np(pthread_self(), "%s", name);
+#elif V8_OS_HURD
+  pthread_setname_np(pthread_self(), name);
 #elif V8_OS_DARWIN
   // pthread_setname_np is only available in 10.6 or later, so test
   // for it at runtime.
