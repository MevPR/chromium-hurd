         *slevel = IPPROTO_IP;
         *sopt = IP_RECVTOS;
+#else
+        // E.g. GNU/Hurd.
+        RTC_LOG(LS_WARNING) << "Socket::OPT_RECV_ECN not supported.";
+        return -1;
+#endif
       }
       break;
 #else
@@ -841,7 +848,8 @@ int PhysicalSocket::TranslateOption(Option opt, int* slevel, int* sopt) {
       *sopt = TCP_KEEPINTVL;
       break;
     case OPT_TCP_USER_TIMEOUT:
