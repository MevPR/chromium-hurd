       break;
-#elif defined(WEBRTC_MAC) || defined(BSD)
+#elif defined(WEBRTC_MAC) || defined(BSD) || !defined(IP_MTU_DISCOVER)
+      // GNU/Hurd defines the IP_PMTUDISC_* values but not the option.
       RTC_LOG(LS_WARNING) << "Socket::OPT_DONTFRAGMENT not supported.";
       return -1;
 #elif defined(WEBRTC_POSIX)
@@ -810,8 +811,14 @@ int PhysicalSocket::TranslateOption(Option opt, int* slevel, int* sopt) {
         *slevel = IPPROTO_IPV6;
         *sopt = IPV6_RECVTCLASS;
       } else {
