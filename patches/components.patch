@@ -34,7 +34,12 @@ absl::Time SystemClock::ElapsedRealtime() {
   // does not increase when system is suspended. We instead use clock_gettime
   // directly. See https://crbug.com/166153.
   struct timespec ts = {};
+#if defined(CLOCK_BOOTTIME)
   const int ret = clock_gettime(CLOCK_BOOTTIME, &ts);
+#else
+  // E.g. GNU/Hurd, which does not suspend: the monotonic clock is equivalent.
+  const int ret = clock_gettime(CLOCK_MONOTONIC, &ts);
+#endif
   DCHECK_EQ(ret, 0);
   return absl::TimeFromTimespec(ts);
 #else
